# Copy to terraform.tfvars (git-ignored) for local plans. CI supplies these via TF_VAR_* from GitHub variables.
region          = "us-east-1"
container_image = "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/icp/app@sha256:<DIGEST>"

