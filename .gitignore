# ---------------------------------------------------------------------------
# Terraform — state, plans and local caches are SENSITIVE. Never commit them.
# ---------------------------------------------------------------------------
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
*.tfplan.json
tfplan
tfplan.*
plan.out
plan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Local variable files can contain account-specific values; commit only *.tfvars.example
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json
# Backend configs written per-account by scripts/bootstrap-backend.sh
backend.hcl
.tflint.d/

# NOTE: .terraform.lock.hcl IS committed on purpose (provider pinning).

# ---------------------------------------------------------------------------
# Secrets / credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
credentials
*.secret

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# ---------------------------------------------------------------------------
# Scanner / tool output
# ---------------------------------------------------------------------------
reports/
trivy-results.*
checkov-results.*
results.sarif

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# Module/example lock files are generated by `make validate`; only roots pin providers.
terraform/modules/**/.terraform.lock.hcl
